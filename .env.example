# Google AI Studio API key (https://aistudio.google.com/apikey); leave empty to use local Qwen only
GEMINI_API_KEY=
# Gemini model used for heavy tasks
GEMINI_MODEL=gemini-flash-latest
# Max Gemini requests per day before falling back to local
GEMINI_DAILY_LIMIT=250
# Local chat model served by Ollama (qwen3:4b-instruct is non-thinking and fast on CPU; the thinking build qwen3:4b also works but is ~10-40x slower)
QWEN_MODEL=qwen3:4b-instruct
# Local embedding model served by Ollama
EMBED_MODEL=nomic-embed-text
# Ollama server address
OLLAMA_URL=http://127.0.0.1:11434
# false = CPU only (default). The 2 GB laptop GPU gave no speed-up and crashed Ollama once.
OLLAMA_USE_GPU=false
# Seconds to wait for one local Qwen answer before giving up (CPU is slow; must be > 0)
QWEN_TIMEOUT_S=240
# Context window (tokens) for every Qwen call; keep one value so Ollama never reloads the model (>= 2048)
QWEN_NUM_CTX=8192
# Routing: split | all_gemini | all_qwen
ROUTING_MODE=split
# Where the database, uploads and notes live (git-ignored)
DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Port of the local Chroma vector server (8000 is the app's port, so this differs)
CHROMA_PORT=8001
# Search blend: 0 = keyword only, 1 = meaning (vector) only (0..1)
HYBRID_ALPHA=0.6
# Re-score search hits with the local cross-encoder reranker
RERANK_ENABLED=true
# Passages returned per search for Gemini (>= 1)
SEARCH_RESULTS=10
# Passages returned per search for local Qwen, which has a smaller context (>= 1)
SEARCH_RESULTS_QWEN=6
# Share of search slots kept for module material over reference books (0..1)
SEARCH_MODULE_SHARE=0.7
# Turn formulas in PDFs into LaTeX while reading (slower, more accurate)
FORMULA_ENRICHMENT=true
# CPU threads used when reading and embedding files (>= 1)
INGEST_THREADS=4
# Where downloaded reading/reranking models are kept (git-ignored)
MODELS_DIR=data/models
